{
  "name": "kldfood",
  "version": "0.1.0",
  "private": true,
  "description": "Food delivery: web + API (YooKassa, R-Keeper White Server)",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @kldfood/api & npm run dev -w @kldfood/web",
    "dev:api": "npm run dev -w @kldfood/api",
    "dev:web": "npm run dev -w @kldfood/web",
    "build": "npm run build:beget",
    "build:beget": "npm run build -w @kldfood/web",
    "build:gh-pages": "cross-env VITE_BASE_PATH=/kldfood/ npm run build -w @kldfood/web",
    "deploy:gh-pages": "npm run build:gh-pages && gh-pages -d dist -t --nojekyll",
    "preview:gh-pages": "npm run build:gh-pages && npm run preview -w @kldfood/web",
    "start": "npm run start -w @kldfood/api",
    "lint": "eslint apps/web/src apps/api/src scripts eslint.config.mjs",
    "typecheck": "tsc --noEmit -p apps/web/tsconfig.json",
    "test": "node --test scripts/ai-task-router.test.mjs",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "ai:route": "node scripts/ai-task-router.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "cross-env": "^7.0.3",
    "eslint": "9.17.0",
    "gh-pages": "^6.3.0",
    "globals": "15.14.0",
    "typescript-eslint": "8.18.2"
  }
}
